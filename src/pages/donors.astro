---
import Layout from '../layouts/Layout.astro';
import DonorsBG from '../images/DonorsBG.png';
---

<Layout>
  <!-- ====== Hero ====== -->
  <section class="relative flex min-h-[60vh] items-center overflow-hidden lg:min-h-[70vh]">
    <!-- Background image with blur -->
    <div class="absolute inset-0">
      <img
        src={DonorsBG.src}
        alt=""
        class="h-full w-full object-cover blur-sm scale-110"
      />
      <!-- Stronger overlay for text pop -->
      <div class="absolute inset-0 bg-gradient-to-t from-[#031A42] via-[#02275A]/85 to-[#02275A]/60"></div>
      <!-- Brand glow -->
      <div class="pointer-events-none absolute -top-32 left-1/2 -translate-x-1/2 h-[500px] w-[800px] max-w-full opacity-[0.2]" style="background: radial-gradient(ellipse 50% 50% at center, #004ADD 0%, transparent 70%);"></div>
    </div>

    <div class="relative z-10 mx-auto flex w-full max-w-4xl flex-col items-center px-4 pb-16 pt-20 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold font-display text-white leading-tight tracking-[-0.02em]" style="text-shadow: 0 1px 2px rgba(0,0,0,0.4), 0 0 1px rgba(255,255,255,0.1);">
        Our Inaugural Donors
      </h1>
      <p class="mt-4 text-lg text-blue-200">Honoring those who made our launch possible</p>
      <p class="mt-6 text-lg text-white/80 max-w-3xl mx-auto leading-relaxed">
        We extend our heartfelt appreciation to the generous individuals and families whose support has helped advance the mission of the Osher Lifelong Learning Institute at Hampton University.
      </p>
    </div>

    <!-- Curved bottom separator — blends hero navy into the donors section teal -->
    <div class="absolute bottom-0 left-0 right-0 z-10 h-16">
      <svg class="h-full w-full" viewBox="0 0 1440 64" preserveAspectRatio="none">
        <defs>
          <linearGradient id="donors-hero-to-first" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#02275A" />
            <stop offset="100%" stop-color="#03205C" />
          </linearGradient>
        </defs>
        <path d="M0 64 Q360 0 720 32 Q1080 64 1440 16 L1440 64 Z" fill="url(#donors-hero-to-first)" />
      </svg>
    </div>
  </section>

  <section id="donors" class="relative py-20 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="sr-only">Inaugural Donors</h2>

      <!-- A -->
      <h3 class="mt-14 mb-4 text-xl font-bold font-display text-[#02275A]">A</h3>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
          <p class="text-base font-semibold text-[#02275A]">Alease Gant</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
          <p class="text-base font-semibold text-[#02275A]">Alice Capehart</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
          <p class="text-base font-semibold text-[#02275A]">Aravia Johnson</p>
