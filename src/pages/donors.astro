<style is:global>
  /* ============================================================
     Donors page — complementary palette + glass donor cards
     Anchored on Hampton blue, warmed with deep teal, muted plum,
     warm gold, and soft coral. Scoped to this page only.
     ============================================================ */

  /* — Smooth section gradient for the donor grid (navy → teal → navy) */
  #donors {
    background:
      radial-gradient(58rem 42rem at 88% 24%, rgba(31, 122, 110, 0.3), transparent 62%),
      radial-gradient(50rem 40rem at 12% 52%, rgba(109, 74, 126, 0.24), transparent 60%),
      radial-gradient(62rem 44rem at 74% 94%, rgba(194, 146, 47, 0.16), transparent 60%),
      linear-gradient(180deg, #03205C 0%, #0B4E4C 53%, #063052 100%);
  }

  /* — Alphabet letter headers: warm gold, celebratory, easy to scan */
  #donors h3 {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin: 2.75rem 0 1.25rem;
    font-family: var(--font-display, "Playfair Display", serif);
    font-weight: 800;
    font-size: 1.3rem;
    line-height: 1;
    letter-spacing: 0.05em;
    color: #F5EBD2;
  }
  #donors h3::after {
    content: "";
    height: 1px;
    width: 3.5rem;
    background: linear-gradient(90deg, rgba(194, 146, 47, 0.7), transparent);
  }

  /* — Glass donor cards: translucent, blurred, softly bordered */
  #donors .grid > div {
