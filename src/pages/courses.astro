---
import Layout from '../layouts/Layout.astro';
import CoursesBG from '../images/CoursesBG.png';
import Group13 from '../images/GroupPhotos/Group13.jpg';
import Group23 from '../images/GroupPhotos/Group23.jpg';
import Group12 from '../images/GroupPhotos/Group12.jpg';
import Group24 from '../images/GroupPhotos/Group24.png';
import Group4 from '../images/GroupPhotos/Group4.jpeg';
import Group10 from '../images/GroupPhotos/Group10.jpg';
import Group9 from '../images/GroupPhotos/Group9.jpeg';
import Group26 from '../images/GroupPhotos/Group26.png';

const catalogImages = Object.entries(
  import.meta.glob('../images/CourseCatalog/*.png', { eager: true, query: '?url', import: 'default' })
)
  .sort(([a], [b]) => {
    const numA = parseInt(a.match(/(\d+)\.png$/)?.[1] || '0');
    const numB = parseInt(b.match(/(\d+)\.png$/)?.[1] || '0');
    return numA - numB;
  })
  .map(([, src]) => src);

const isCover = (i) => i === 0;
const isLastInLeftPair = (i) => i > 0 && i % 2 === 1;
const isFirstInRightPair = (i) => i > 0 && i % 2 === 0;
---

<Layout>
  <!-- ====== Hero ====== -->
  <section class="relative flex min-h-[60vh] items-center overflow-hidden lg:min-h-[70vh]">
    <div class="absolute inset-0">
      <img
        src={CoursesBG.src}
        alt="OLLI course catalog"
        class="h-full w-full object-cover blur-sm scale-110"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[#02275A]/90 via-[#02275A]/70 to-[#02275A]/45"></div>
      <div class="pointer-events-none absolute -top-32 left-1/2 -translate-x-1/2 h-[500px] w-[800px] max-w-full opacity-[0.2]" style="background: radial-gradient(ellipse 50% 50% at center, #004ADD 0%, transparent 70%);"></div>
    </div>

    <div class="relative z-10 mx-auto w-full max-w-4xl px-4 pb-16 pt-24 text-center sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold font-display text-white leading-tight tracking-[-0.02em]" style="text-shadow: 0 1px 2px rgba(0,0,0,0.4), 0 0 1px rgba(255,255,255,0.1);">
          Welcome to OLLI HU
        </h1>
        <p class="mt-6 text-lg text-white/80 max-w-3xl mx-auto leading-relaxed">
          We're thrilled to have you here! At OLLI, we believe that learning never stops. Whether you're exploring a new passion, diving deeper into a lifelong interest, or simply looking to connect with a vibrant community of fellow learners, you've come to the right place.
        </p>
        <p class="mt-4 text-lg text-white/80 max-w-3xl mx-auto leading-relaxed">
          Our courses are designed to engage, inspire, and empower—no tests, no grades, just the joy of learning for learning's sake. From history and science to art, literature, and wellness, there's something here for everyone.
        </p>
      </div>
    </div>

    <!-- Curved bottom separator -->
    <div class="absolute bottom-0 left-0 right-0 z-10 h-16">
      <svg class="h-full w-full" viewBox="0 0 1440 64" preserveAspectRatio="none">
        <defs>
          <linearGradient id="courses-hero-to-first" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#02275A" />
            <stop offset="100%" stop-color="#0E5C9C" />
          </linearGradient>
        </defs>
        <path d="M0 64 Q360 0 720 32 Q1080 64 1440 16 L1440 64 Z" fill="url(#courses-hero-to-first)" />
      </svg>
    </div>
  </section>

  <section class="bg-gradient-to-b from-[#0E5C9C] via-[#2E8FAD] to-[#E87464] py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[1.2fr_1fr] items-center">
        <div class="rounded-2xl border border-white/30 bg-white/10 p-4 shadow-[0_8px_32px_rgba(2,39,90,0.2)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/50 hover:bg-white/15 hover:shadow-[0_14px_44px_rgba(2,39,90,0.3)] sm:p-6">
          <img
            src={catalogImages[0]}
            alt="OLLI Course Catalog cover"
            class="mx-auto h-auto w-full max-h-[480px] rounded-2xl object-contain"
            loading="lazy"
          />
          <div class="mt-5 text-center">
            <button id="open-catalog-btn" class="inline-flex cursor-pointer items-center justify-center rounded-full bg-[#004ADD] px-6 py-3 text-base font-semibold text-white shadow-sm transition hover:bg-[#02275A] hover:shadow-lg hover:-translate-y-0.5">
              Click here to view the course catalog
            </button>
          </div>
        </div>

        <div class="rounded-2xl border border-white/30 bg-white/10 p-8 shadow-[0_8px_32px_rgba(2,39,90,0.2)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/50 hover:bg-white/15 hover:shadow-[0_14px_44px_rgba(2,39,90,0.3)] sm:p-10">
          <h2 class="text-3xl font-extrabold font-display text-white drop-shadow-sm">Ready to discover your next adventure?</h2>
          <p class="mt-4 text-lg leading-relaxed text-white/90">
            Browse our courses, meet our incredible instructors, and join a community where curiosity knows no age limit.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="mailto:osherhamptonu@gmail.com" class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3 text-base font-semibold text-[#02275A] shadow-lg transition hover:bg-blue-50 hover:shadow-xl hover:-translate-y-0.5">
              Email Us
            </a>
            <a href="tel:7577275434" class="inline-flex items-center justify-center rounded-full border border-white/50 bg-white/10 px-6 py-3 text-base font-semibold text-white shadow-sm transition hover:bg-white/20 hover:shadow-md hover:-translate-y-0.5">
              Call 757-727-5434
            </a>
          </div>
          <p class="mt-6 text-base leading-relaxed text-white/80">
            For questions or assistance, please call <strong class="font-semibold text-white">757-727-5434</strong> or email us at <a href="mailto:osherhamptonu@gmail.com" class="font-semibold text-white underline decoration-1 underline-offset-2 hover:text-blue-100 transition">osherhamptonu@gmail.com</a>.
          </p>
        </div>
      </div>

      <!-- Community feature: interactive learning -->
      <div class="mt-20 grid items-center gap-10 lg:grid-cols-[1.15fr_1fr]">
        <div class="order-2 rounded-2xl border border-white/30 bg-white/10 p-4 shadow-[0_8px_32px_rgba(2,39,90,0.2)] backdrop-blur-md lg:order-1">
          <img
            src={Group23.src}
            alt="OLLI members learning together in an interactive class"
            class="h-auto w-full rounded-xl object-cover"
            loading="lazy"
          />
        </div>
        <div class="order-1 rounded-2xl border border-white/30 bg-white/10 p-8 shadow-[0_8px_32px_rgba(2,39,90,0.2)] backdrop-blur-md lg:order-2 sm:p-10">
          <h2 class="text-3xl font-extrabold font-display text-white drop-shadow-sm">Learning is livelier together</h2>
          <p class="mt-4 text-lg leading-relaxed text-white/90">
            Our sessions are built around conversation, curiosity, and connection — members aren't just audiences, they're part of the energy in the room. Whether it's a spirited discussion or a new technique picked up side by side, the joy of discovery multiplies the moment it's shared.
          </p>
        </div>
      </div>

      <!-- Community feature: teaching -->
      <div class="mt-16 grid items-center gap-10 lg:grid-cols-[1fr_1.15fr]">
        <div class="rounded-2xl border border-white/30 bg-white/10 p-8 shadow-[0_8px_32px_rgba(2,39,90,0.2)] backdrop-blur-md sm:p-10">
          <h2 class="text-3xl font-extrabold font-display text-white drop-shadow-sm">Guided by passionate instructors</h2>
          <p class="mt-4 text-lg leading-relaxed text-white/90">
            Our member-led courses are taught by people who love what they teach — experts, hobbyists, and long-time learners who lead with warmth, patience, and genuine enthusiasm. You'll feel encouraged from the very first class.
          </p>
        </div>
        <div class="rounded-2xl border border-white/30 bg-white/10 p-4 shadow-[0_8px_32px_rgba(2,39,90,0.2)] backdrop-blur-md">
          <img
            src={Group13.src}
            alt="An OLLI instructor teaching a course"
            class="h-auto w-full rounded-xl object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gradient-to-b from-[#E87464] via-[#C2537F] to-[#02275A] py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-extrabold font-display text-white">Current Courses</h2>
        <p class="mt-4 text-lg text-white/90">Engaging, accessible, and member-led learning experiences designed for adults 50 and better.</p>
      </div>

      <!-- Fitness featured photo -->
      <div class="relative mb-14 overflow-hidden rounded-2xl border border-white/30 bg-white/10 shadow-[0_8px_32px_rgba(2,39,90,0.2)] backdrop-blur-md">
        <img
          src={Group12.src}
          alt="OLLI members moving together in a fitness class"
          class="h-64 w-full object-cover sm:h-80 lg:h-96"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#02275A]/85 via-[#02275A]/25 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/80">Move, sweat, smile</p>
          <h3 class="mt-2 text-2xl font-extrabold font-display text-white drop-shadow-sm sm:text-3xl">Fitness is better with friends by your side</h3>
        </div>
      </div>

      <h3 class="mt-12 mb-4 text-xl font-bold font-display text-white">Fitness &amp; Dance</h3>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl border border-white/30 bg-white/10 p-6 shadow-[0_8px_28px_rgba(2,39,90,0.16)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/50 hover:bg-white/15 hover:shadow-[0_14px_40px_rgba(2,39,90,0.28)]">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/80 mb-3">Fitness</p>
          <h3 class="text-xl font-bold font-display text-white">Move Your Body: Fitness</h3>
          <p class="mt-3 text-base leading-relaxed text-white/90">
            An energetic weightlifting and strength-training class where participants learn to move more freely while gaining strength and flexibility through weights, resistance bands, and varied exercises.
          </p>
        </div>
        <div class="rounded-2xl border border-white/30 bg-white/10 p-6 shadow-[0_8px_28px_rgba(2,39,90,0.16)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/50 hover:bg-white/15 hover:shadow-[0_14px_40px_rgba(2,39,90,0.28)]">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/80 mb-3">Dance</p>
          <h3 class="text-xl font-bold font-display text-white">Line Dancing for Everyone (Beginners)</h3>
          <p class="mt-3 text-base leading-relaxed text-white/90">
            Learn basic steps and simple dances that promote fun, fitness, confidence, mental stimulation, and social connection.
          </p>
        </div>

        <div class="rounded-2xl border border-white/30 bg-white/10 p-6 shadow-[0_8px_28px_rgba(2,39,90,0.16)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/50 hover:bg-white/15 hover:shadow-[0_14px_40px_rgba(2,39,90,0.28)]">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/80 mb-3">Dance</p>
          <h3 class="text-xl font-bold font-display text-white">Line Dancing for Everyone (Returning Steppers)</h3>
          <p class="mt-3 text-base leading-relaxed text-white/90">
            A more advanced line dancing class that challenges memory, coordination, and confidence through multi-step routines while encouraging movement and fun.
          </p>
        </div>

        <div class="rounded-2xl border border-white/30 bg-white/10 p-6 shadow-[0_8px_28px_rgba(2,39,90,0.16)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/50 hover:bg-white/15 hover:shadow-[0_14px_40px_rgba(2,39,90,0.28)]">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/80 mb-3">Dance &amp; Fitness</p>
          <h3 class="text-xl font-bold font-display text-white">Salsa-Cise</h3>
          <p class="mt-3 text-base leading-relaxed text-white/90">
            A dance fitness class that uses Latin rhythms and movement to lift the spirit, reduce stress, and promote physical and mental well-being. No prior experience is required.
          </p>
        </div>

        <div class="rounded-2xl border border-white/30 bg-white/10 p-6 shadow-[0_8px_28px_rgba(2,39,90,0.16)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/50 hover:bg-white/15 hover:shadow-[0_14px_40px_rgba(2,39,90,0.28)]">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/80 mb-3">Fitness</p>
          <h3 class="text-xl font-bold font-display text-white">Zumba</h3>
          <p class="mt-3 text-base leading-relaxed text-white/90">
            A popular exercise program that combines Latin music with choreographed dance movements to create an engaging aerobic workout.
          </p>
        </div>

        <div class="rounded-2xl border border-white/30 bg-white/10 p-6 shadow-[0_8px_28px_rgba(2,39,90,0.16)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/50 hover:bg-white/15 hover:shadow-[0_14px_40px_rgba(2,39,90,0.28)]">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/80 mb-3">Wellness</p>
          <h3 class="text-xl font-bold font-display text-white">Yoga For Everyone</h3>
          <p class="mt-3 text-base leading-relaxed text-white/90">
            A yoga class focused on uniting body, breath, and mind through mindful movement, relaxation, and meditation to support healthy aging and wellness.
          </p>
        </div>
      </div>

      <h3 class="mt-12 mb-4 text-xl font-bold font-display text-white">Arts &amp; Crafts</h3>

      <!-- Arts & crafts featured photo -->
      <div class="relative mb-14 overflow-hidden rounded-2xl border border-white/30 bg-white/10 shadow-[0_8px_32px_rgba(2,39,90,0.2)] backdrop-blur-md">
        <img
          src={Group24.src}
          alt="OLLI members crafting together in an arts class"
          class="h-64 w-full object-cover sm:h-80 lg:h-96"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#02275A]/85 via-[#02275A]/25 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/80">Create, connect, inspire</p>
          <h3 class="mt-2 text-2xl font-extrabold font-display text-white drop-shadow-sm sm:text-3xl">Arts &amp; crafts are better together</h3>
        </div>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl border border-white/30 bg-white/10 p-6 shadow-[0_8px_28px_rgba(2,39,90,0.16)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/50 hover:bg-white/15 hover:shadow-[0_14px_40px_rgba(2,39,90,0.28)]">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/80 mb-3">Arts &amp; Crafts</p>
          <h3 class="text-xl font-bold font-display text-white">Handmade Greeting Cards</h3>
          <p class="mt-3 text-base leading-relaxed text-white/90">
            Learn how to create unique handmade greeting cards using different card-making tools and techniques that family and friends will treasure.
          </p>
        </div>
      </div>

      <h3 class="mt-12 mb-4 text-xl font-bold font-display text-white">Languages</h3>

      <!-- Languages featured photo -->
      <div class="relative mb-14 overflow-hidden rounded-2xl border border-white/30 bg-white/10 shadow-[0_8px_32px_rgba(2,39,90,0.2)] backdrop-blur-md">
        <img
          src={Group9.src}
          alt="OLLI members learning a new language together"
          class="h-64 w-full object-cover sm:h-80 lg:h-96"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#02275A]/85 via-[#02275A]/25 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/80">Learn something new</p>
          <h3 class="mt-2 text-2xl font-extrabold font-display text-white drop-shadow-sm sm:text-3xl">A new language opens new worlds</h3>
        </div>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl border border-white/30 bg-white/10 p-6 shadow-[0_8px_28px_rgba(2,39,90,0.16)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/50 hover:bg-white/15 hover:shadow-[0_14px_40px_rgba(2,39,90,0.28)]">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/80 mb-3">Language</p>
          <h3 class="text-xl font-bold font-display text-white">Intermediate Spanish</h3>
          <p class="mt-3 text-base leading-relaxed text-white/90">
            Designed for members with a basic background in Spanish pronunciation, grammar, and vocabulary who want to continue developing their Spanish skills. <em>In person &amp; virtual.</em>
          </p>
        </div>

        <div class="rounded-2xl border border-white/30 bg-white/10 p-6 shadow-[0_8px_28px_rgba(2,39,90,0.16)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/50 hover:bg-white/15 hover:shadow-[0_14px_40px_rgba(2,39,90,0.28)]">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/80 mb-3">Language</p>
          <h3 class="text-xl font-bold font-display text-white">Beginning Spanish</h3>
          <p class="mt-3 text-base leading-relaxed text-white/90">
            Designed for members who want to begin learning how to speak Spanish fluently. <em>In person &amp; virtual.</em>
          </p>
        </div>
      </div>

      <h3 class="mt-12 mb-4 text-xl font-bold font-display text-white">Book Club &amp; Discussion</h3>

      <!-- Book club featured photo -->
      <div class="relative mb-14 overflow-hidden rounded-2xl border border-white/30 bg-white/10 shadow-[0_8px_32px_rgba(2,39,90,0.2)] backdrop-blur-md">
        <img
          src={Group10.src}
          alt="OLLI members reading and discussing a book together"
          class="h-64 w-full object-cover sm:h-80 lg:h-96"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#02275A]/85 via-[#02275A]/25 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/80">Read, reflect, connect</p>
          <h3 class="mt-2 text-2xl font-extrabold font-display text-white drop-shadow-sm sm:text-3xl">Great conversations start with a good book</h3>
        </div>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl border border-white/30 bg-white/10 p-6 shadow-[0_8px_28px_rgba(2,39,90,0.16)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/50 hover:bg-white/15 hover:shadow-[0_14px_40px_rgba(2,39,90,0.28)]">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/80 mb-3">Book Club</p>
          <h3 class="text-xl font-bold font-display text-white">Kings Roundtable Osher Book Club</h3>
          <p class="mt-3 text-base leading-relaxed text-white/90">
            An interest group centered around reading, discussion, and sharing a love of storytelling.
          </p>
        </div>

        <div class="rounded-2xl border border-white/30 bg-white/10 p-6 shadow-[0_8px_28px_rgba(2,39,90,0.16)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/50 hover:bg-white/15 hover:shadow-[0_14px_40px_rgba(2,39,90,0.28)]">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/80 mb-3">Discussion</p>
          <h3 class="text-xl font-bold font-display text-white">Knowledge More Abundantly</h3>
          <p class="mt-3 text-base leading-relaxed text-white/90">
            Explores the nature of knowledge, truth, and misinformation through guided discussions and debates about sources of knowledge, personal biases, and distinguishing fact from myth.
          </p>
        </div>
      </div>

      <!-- Community close: classroom + connection -->
      <div class="mt-16 grid gap-6 sm:grid-cols-2">
        <div class="group relative overflow-hidden rounded-2xl border border-white/30 bg-white/10 shadow-[0_8px_28px_rgba(2,39,90,0.16)] backdrop-blur-md">
          <img
            src={Group26.src}
            alt="OLLI members engaged in classroom learning"
            class="h-64 w-full object-cover transition-transform duration-300 group-hover:scale-[1.03] sm:h-80"
            loading="lazy"
          />
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#02275A]/80 to-transparent p-5">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/80">In the classroom</p>
          </div>
        </div>
        <div class="group relative overflow-hidden rounded-2xl border border-white/30 bg-white/10 shadow-[0_8px_28px_rgba(2,39,90,0.16)] backdrop-blur-md">
          <img
            src={Group4.src}
            alt="OLLI members connecting as a community"
            class="h-64 w-full object-cover transition-transform duration-300 group-hover:scale-[1.03] sm:h-80"
            loading="lazy"
          />
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#02275A]/80 to-transparent p-5">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/80">The heart of it all</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <dialog id="catalog-modal" class="fixed inset-0 z-[100] h-full max-h-none w-full max-w-none bg-black/70 p-4 backdrop:bg-black/70 open:flex open:items-center open:justify-center">
    <div class="relative w-full max-w-5xl rounded-2xl bg-white p-2 shadow-2xl sm:p-4">
      <button onclick="document.getElementById('catalog-modal').close()" class="absolute -right-3 -top-3 z-10 flex h-9 w-9 items-center justify-center rounded-full bg-[#02275A] text-white shadow-lg transition hover:bg-[#004ADD]" aria-label="Close catalog">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>

      <div class="swiper [--swiper-navigation-size:24px]" id="catalog-swiper">
        <div class="swiper-wrapper">
          {catalogImages.map((img, idx) => (
            <div class="swiper-slide !flex items-center justify-center {isCover(idx) ? 'cover-slide' : ''}">
              <div class="flex w-full items-center justify-center {isCover(idx) ? 'max-w-[80%]' : ''}">
                <div class="relative flex-1 {!isCover(idx) && isLastInLeftPair(idx) ? 'pr-1 md:pr-2' : ''} {!isCover(idx) && isFirstInRightPair(idx) ? 'pl-1 md:pl-2' : ''}">
                  {!isCover(idx) && isLastInLeftPair(idx) && <div class="pointer-events-none absolute inset-y-0 right-0 w-3 bg-gradient-to-l from-black/5 to-transparent z-10" />}
                  {!isCover(idx) && isFirstInRightPair(idx) && <div class="pointer-events-none absolute inset-y-0 left-0 w-2 bg-gradient-to-r from-black/5 to-transparent z-10" />}
                  <img
                    src={img}
                    alt={`OLLI Course Catalog page $${idx + 1}`}
                    class="h-auto max-h-[75vh] w-full object-contain drop-shadow-[1px_0_4px_rgba(0,0,0,0.12)]"
                    style="background: linear-gradient(135deg, #fefefe 0%, #f8f6f0 100%);"
                    loading="lazy"
                  />
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="swiper-pagination !relative !mt-3"></div>
        <div class="swiper-button-prev !text-[#004ADD]"></div>
        <div class="swiper-button-next !text-[#004ADD]"></div>
      </div>
    </div>
  </dialog>

  <style>
    #catalog-swiper {
      perspective: 1600px;
    }
    #catalog-swiper .swiper-slide {
      transition: transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.4s ease;
    }
    #catalog-swiper.md\:two-up {
      perspective: 1600px;
    }
    #catalog-swiper.md\:two-up .swiper-slide-prev {
      opacity: 0.4;
      transform: perspective(1600px) rotateY(18deg) scale(0.92);
      transform-origin: right center;
    }
    #catalog-swiper.md\:two-up .swiper-slide-next {
      opacity: 0.4;
      transform: perspective(1600px) rotateY(-18deg) scale(0.92);
      transform-origin: left center;
    }
    #catalog-swiper.md\:two-up .swiper-slide-active {
      opacity: 1;
      transform: perspective(1600px) rotateY(0deg) scale(1);
    }
    #catalog-swiper:not(.md\:two-up) .swiper-slide {
      opacity: 1 !important;
      transform: none !important;
    }
    #catalog-swiper:not(.md\:two-up) .swiper-slide img {
      max-height: 85vh;
    }
    #catalog-swiper.md\:two-up .cover-slide > div {
      max-width: none !important;
    }

    /* Pagination — keep every dot on a single line, centered, never overflowing the page */
    #catalog-swiper .swiper-pagination {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
      justify-content: center;
      gap: 6px;
      width: 100%;
      max-width: 100%;
      margin-inline: auto;
      padding: 6px 0 2px;
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      -ms-overflow-style: none;
      scroll-behavior: smooth;
    }
    #catalog-swiper .swiper-pagination::-webkit-scrollbar {
      display: none;
    }
    #catalog-swiper .swiper-pagination .swiper-pagination-bullet {
      flex: 0 0 auto;
      width: 9px;
      height: 9px;
      border-radius: 9999px;
      background: rgba(2, 39, 90, 0.32);
      opacity: 1;
      box-shadow: none;
      transition: background 0.25s ease, transform 0.25s ease;
    }
    #catalog-swiper .swiper-pagination .swiper-pagination-bullet-active {
      background: #004add;
      transform: scale(1.2);
    }
    @media (max-width: 767px) {
      #catalog-swiper .swiper-pagination {
        gap: 5px;
        padding-top: 6px;
      }
      #catalog-swiper .swiper-pagination .swiper-pagination-bullet {
        width: 8px;
        height: 8px;
      }
    }
  </style>

  <script>
    import Swiper from 'swiper';
    import { Navigation, Pagination, Keyboard } from 'swiper/modules';
    import 'swiper/css';
    import 'swiper/css/navigation';
    import 'swiper/css/pagination';

    let swiperInstance = null;

    document.getElementById('open-catalog-btn')?.addEventListener('click', function () {
      const modal = document.getElementById('catalog-modal');
      modal.showModal();

      if (!swiperInstance) {
        const el = document.getElementById('catalog-swiper');
        if (el) {
          const isDesktop = () => window.innerWidth >= 768;

          swiperInstance = new Swiper(el, {
            modules: [Navigation, Pagination, Keyboard],
            slidesPerView: 1,
            slidesPerGroup: 1,
            spaceBetween: 0,
            navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' },
            pagination: { el: '.swiper-pagination', clickable: true },
            keyboard: { enabled: true },
            grabCursor: true,
            breakpoints: {
              768: {
                slidesPerView: 2,
                slidesPerGroup: 2,
                spaceBetween: 0,
              },
            },
            on: {
              init: function () {
                this.el.classList.toggle('md\\:two-up', isDesktop());
              },
              resize: function () {
                this.el.classList.toggle('md\\:two-up', isDesktop());
              },
              slideChange: function () {
                const pag = this.pagination?.el;
                const active = pag?.querySelector('.swiper-pagination-bullet-active');
                if (active && pag && pag.scrollWidth > pag.clientWidth) {
                  active.scrollIntoView({
                    block: 'nearest',
                    inline: 'center',
                    behavior: 'smooth',
                  });
                }
              },
            },
          });
        }
      } else {
        swiperInstance.update();
      }
    });
  </script>
</Layout>
