---
import Layout from '../layouts/Layout.astro';
import AboutBG from '../images/AboutBG.png';
import SpotlightMember from '../images/SpotlightMember.png';
import Group41 from '../images/GroupPhotos/Group41.png';
import Group8 from '../images/GroupPhotos/Group8.jpeg';
import Group31 from '../images/GroupPhotos/Group31.jpg';
import Group36 from '../images/GroupPhotos/Group36.jpeg';
---

<Layout>
  <!-- ====== Hero ====== -->
  <section class="relative flex min-h-[60vh] items-center overflow-hidden lg:min-h-[70vh]">
    <div class="absolute inset-0">
      <img
        src={AboutBG.src}
        alt="OLLI members in community"
        class="h-full w-full object-cover blur-sm scale-110"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[#02275A]/90 via-[#02275A]/70 to-[#02275A]/45"></div>
      <div class="pointer-events-none absolute -top-32 left-1/2 -translate-x-1/2 h-[500px] w-[800px] max-w-full opacity-[0.2]" style="background: radial-gradient(ellipse 50% 50% at center, #004ADD 0%, transparent 70%);"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-4xl px-4 pb-16 pt-24 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold font-display text-white leading-tight" style="text-shadow: 0 1px 2px rgba(0,0,0,0.4), 0 0 1px rgba(255,255,255,0.1);">
        Championing lifelong learning for adults 50 and better
      </h1>
      <p class="mt-6 text-lg text-white/80 max-w-3xl mx-auto leading-relaxed">
        The Bernard Osher Foundation has supported a national network of Osher Lifelong Learning Institutes for more than four decades. OLLI at Hampton University brings that legacy to Hampton Roads with affordable, community-driven programming designed to enrich every stage of life.
      </p>
    </div>

    <!-- Curved bottom separator -->
    <div class="absolute bottom-0 left-0 right-0 z-10 h-16">
      <svg class="h-full w-full" viewBox="0 0 1440 64" preserveAspectRatio="none">
        <defs>
          <linearGradient id="about-hero-to-first" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#02275A" />
            <stop offset="100%" stop-color="#0E5C9C" />
          </linearGradient>
        </defs>
        <path d="M0 64 Q360 0 720 32 Q1080 64 1440 16 L1440 64 Z" fill="url(#about-hero-to-first)" />
      </svg>
    </div>
  </section>

  <section class="bg-gradient-to-b from-[#0E5C9C] via-[#2E8FAD] to-[#1CAE9F] py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
      <!-- OLLI at Hampton University + Group15 -->
      <div class="grid items-center gap-10 lg:grid-cols-[1.7fr_1fr]">
        <div class="rounded-2xl border border-white/20 bg-white/10 p-10 shadow-[0_8px_32px_rgba(2,39,90,0.25)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/40 hover:bg-white/15 hover:shadow-[0_14px_44px_rgba(2,39,90,0.35)]">
          <div class="h-px w-12 bg-white/40 mb-4"></div>
          <h2 class="text-2xl font-extrabold font-display text-white mb-4">OLLI at Hampton University</h2>
          <p class="text-base leading-relaxed text-[#E4EBFB]">
            OLLI at Hampton furthers the pursuit of lifelong learning by offering affordable, accessible, high-quality educational programs for the population 50 and better in the Hampton Roads area.
          </p>
          <p class="mt-4 text-base leading-relaxed text-[#E4EBFB]">
            Programs are conducted in an environment that fosters members’ participation in the planning, execution, and assessment of all programs. OLLI broadens and enriches the lives of its members by challenging intellectual activities that stimulate creativity.
          </p>
        </div>
        <div class="group rounded-2xl border border-white/20 bg-white/10 p-4 shadow-[0_8px_32px_rgba(2,39,90,0.25)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/40 hover:shadow-[0_14px_44px_rgba(2,39,90,0.35)]">
          <img
            src={Group41.src}
            alt="OLLI Advisory Board members at Hampton University."
            class="h-64 w-full rounded-xl object-cover transition-transform duration-500 group-hover:scale-[1.03] sm:h-80 lg:h-96"
            loading="lazy"
          />
        </div>
      </div>

      <!-- A nationwide lifelong learning network + Group8 -->
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.7fr]">
        <div class="order-2 rounded-2xl border border-white/20 bg-white/10 p-4 shadow-[0_8px_32px_rgba(2,39,90,0.25)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/40 hover:shadow-[0_14px_44px_rgba(2,39,90,0.35)] lg:order-1">
          <img
            src={Group8.src}
            alt="OLLI members finding a sense of belonging together"
            class="h-64 w-full rounded-xl object-cover transition-transform duration-500 group-hover:scale-[1.03] sm:h-80 lg:h-96"
            loading="lazy"
          />
        </div>
        <div class="order-1 rounded-2xl border border-white/20 bg-white/10 p-10 shadow-[0_8px_32px_rgba(2,39,90,0.25)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/40 hover:bg-white/15 hover:shadow-[0_14px_44px_rgba(2,39,90,0.35)] lg:order-2">
          <div class="h-px w-12 bg-white/40 mb-4"></div>
          <h2 class="text-2xl font-extrabold font-display text-white mb-4">A nationwide lifelong learning network</h2>
          <p class="text-base leading-relaxed text-[#E1F5F0]">
            The Foundation supports a national lifelong learning network of programs designed for adults 50 and better; Osher Lifelong Learning Institutes operate on 120+ college and university campuses in all 50 states and the District of Columbia.
          </p>
        </div>
      </div>

      <!-- Wide community image: Group31 -->
      <div class="group overflow-hidden rounded-2xl border border-white/20 bg-white/10 shadow-[0_8px_32px_rgba(2,39,90,0.25)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/40 hover:shadow-[0_14px_44px_rgba(2,39,90,0.35)]">
        <img
          src={Group31.src}
          alt="A larger gathering of the OLLI community celebrating together"
          class="h-64 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] sm:h-80 lg:h-[28rem]"
          loading="lazy"
        />
        <div class="p-6 sm:p-8">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/80">A community that grows together</p>
        </div>
      </div>

      <!-- A foundation built for impact + Group3 -->
      <div class="grid items-center gap-10 lg:grid-cols-[1.7fr_1fr]">
        <div class="rounded-2xl border border-white/20 bg-white/10 p-10 shadow-[0_8px_32px_rgba(2,39,90,0.25)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/40 hover:bg-white/15 hover:shadow-[0_14px_44px_rgba(2,39,90,0.35)]">
          <div class="h-px w-12 bg-white/40 mb-4"></div>
          <h2 class="text-2xl font-extrabold font-display text-white mb-4">A foundation built for impact</h2>
          <p class="text-base leading-relaxed text-[#E1F5F0]">
            Bernard Osher Foundation, headquartered in San Francisco, was founded in 1977 by respected businessman, philanthropist, and community leader Bernard Osher. The Foundation seeks to improve quality of life through innovative funding in higher education and the arts.
          </p>
        </div>
        <div class="group rounded-2xl border border-white/20 bg-white/10 p-4 shadow-[0_8px_32px_rgba(2,39,90,0.25)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/40 hover:shadow-[0_14px_44px_rgba(2,39,90,0.35)]">
          <img
            src={Group36.src}
            alt="OLLI members engaged in classroom learning"
            class="h-64 w-full rounded-xl object-cover transition-transform duration-500 group-hover:scale-[1.03] sm:h-80 lg:h-96"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Lower section: glass sidebar -->
  <section class="bg-gradient-to-b from-[#1CAE9F] via-[#2E8FAD] to-[#02275A] py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-3">
        <div class="rounded-2xl border border-white/20 bg-white/10 p-10 text-white shadow-[0_8px_32px_rgba(2,39,90,0.25)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/40 hover:bg-white/15 hover:shadow-[0_14px_44px_rgba(2,39,90,0.35)] lg:col-span-2">
          <p class="text-sm uppercase tracking-[0.3em] font-bold text-[#A5DBD2]">Osher Institute Legacy</p>
          <h3 class="mt-4 text-3xl font-extrabold font-display">Watch the story</h3>
          <p class="mt-4 text-sm leading-relaxed text-[#DDE8E8]">
            View a brief animated video history of The Osher Institute Legacy of Bernard Osher.
          </p>
          <a href="https://vimeo.com/873071530?share=copy" target="_blank" rel="noreferrer" class="inline-flex items-center justify-center w-full mt-8 rounded-full bg-white px-6 py-3 text-center text-[#02275A] font-semibold shadow-lg hover:bg-[#F3F8FC] transition">
            Watch the Video
          </a>
        </div>

        <div class="rounded-2xl border border-white/20 bg-white/10 p-8 shadow-[0_8px_32px_rgba(2,39,90,0.25)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/40 hover:bg-white/15 hover:shadow-[0_14px_44px_rgba(2,39,90,0.35)]">
          <h4 class="text-xl font-semibold text-white mb-3">Why OLLI?</h4>
          <ul class="space-y-4 text-[#E6FBF7]">
            <li><strong class="font-semibold text-white">Accessible</strong> programs with no grades, no tests, and no homework.</li>
            <li><strong class="font-semibold text-white">Member-led</strong> learning shaped by the interests of the community.</li>
            <li><strong class="font-semibold text-white">Engaging</strong> courses, travel, and social activities for lifelong learners.</li>
          </ul>
        </div>
      </div>

      <div class="mt-8 rounded-2xl border border-white/20 bg-white/10 p-8 shadow-[0_8px_32px_rgba(2,39,90,0.25)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/40 hover:bg-white/15 hover:shadow-[0_14px_44px_rgba(2,39,90,0.35)]">
        <p class="text-sm uppercase tracking-[0.3em] text-white font-bold mb-4">Learn More</p>
        <div class="grid gap-4 sm:grid-cols-2">
          <a href="https://www.osherfoundation.org/" target="_blank" rel="noreferrer" class="inline-flex items-center justify-center rounded-full bg-[#004ADD] px-6 py-4 text-center text-base font-semibold text-white shadow-lg hover:bg-[#02275A] transition">
            Osher Foundation
          </a>
          <a href="https://www.hamptonu.edu/" target="_blank" rel="noreferrer" class="inline-flex items-center justify-center rounded-full bg-[#004ADD] px-6 py-4 text-center text-base font-semibold text-white shadow-lg hover:bg-[#02275A] transition">
            Hampton University
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Spotlight Member -->
  <section class="bg-gradient-to-b from-[#02275A] to-[#132A66] py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="group overflow-hidden rounded-2xl border border-white/20 bg-white/10 shadow-[0_8px_32px_rgba(2,39,90,0.25)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-white/40 hover:bg-white/15 hover:shadow-[0_14px_44px_rgba(2,39,90,0.35)]">
        <div class="grid items-stretch gap-0 lg:grid-cols-2">
          <div class="min-h-[320px]">
            <img
              src={SpotlightMember.src}
              alt="Wayne Keene"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <div class="p-8 sm:p-10 lg:p-12">
            <p class="text-sm font-bold uppercase tracking-[0.3em] text-[#A5DBD2]">
              Spotlight Member
            </p>

            <h2 class="mt-3 text-3xl font-extrabold font-display text-white sm:text-4xl">
              Wayne Keene
            </h2>

            <div class="mt-6 space-y-4 text-base leading-relaxed text-white/85">
              <p>
                Wayne Keene is a retired Virginia Department of Transportation (VDOT) inspector who played a hands-on role in the original 1976 construction and refurbishment of the Hampton Roads Bridge-Tunnel (HRBT).
              </p>
              <p>
                Recognized for his historical legacy in the region, Keene revisited the <a href="https://www.linkedin.com/posts/alexandre-guillaume-ms_what-a-magnificent-project-what-a-wonderful-activity-7272683352820768769-GeKc" target="_blank" rel="noreferrer" class="font-semibold text-[#A5DBD2] underline underline-offset-4 hover:text-white transition-colors">HRBT Expansion Project Welcome Center</a> to celebrate the infrastructure's ongoing development.
              </p>
              <p>
                He was featured in the <a href="https://myemail.constantcontact.com/HRBT-Expansion-Project-Newsletter.html?soid=1132998776519&aid=uuLbafxjUpU" target="_blank" rel="noreferrer" class="font-semibold text-[#A5DBD2] underline underline-offset-4 hover:text-white transition-colors">HRBT Expansion Project Newsletter</a> as a local Hampton resident and key contributor to the original 1957 and 1976 tunnels.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
