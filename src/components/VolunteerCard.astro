---
// src/components/VolunteerCard.astro
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---
<div class="rounded-2xl border border-white/40 bg-white/15 p-8 shadow-[0_8px_32px_rgba(2,39,90,0.18)] backdrop-blur-md transition-all duration-300 group hover:-translate-y-0.5 hover:border-white/60 hover:bg-white/20 hover:shadow-[0_12px_40px_rgba(2,39,90,0.25)]">
  <h3 class="text-2xl font-bold font-display text-white mb-4 drop-shadow-sm group-hover:text-white transition-colors">
    {title}
  </h3>
  <p class="text-white/90 leading-relaxed text-base mb-6">
    {description}
  </p>
  <a href="https://www.jotform.com/form/250904273696060" target="_blank" rel="noopener" class="inline-flex items-center font-bold text-white transition hover:text-white/80">
    Sign Up Today 
    <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  </a>
</div>