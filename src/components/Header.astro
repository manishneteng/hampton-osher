  <script>
    const header = document.getElementById('site-header');
    const dropdowns = Array.from(document.querySelectorAll('details[data-nav-dropdown]'));
    const mobileMenu = document.querySelector('header details.md\\:hidden');
    const isDesktop = () => window.matchMedia('(min-width: 768px)').matches;

    const updateHeaderGlass = () => {
      if (!header) return;
      const scrolled = window.scrollY > 8;
      header.classList.toggle('header-scrolled', scrolled);
    };

    updateHeaderGlass();
    document.addEventListener('scroll', updateHeaderGlass, { passive: true });

    const closeAllDropdowns = () => {
      dropdowns.forEach((dropdown) => dropdown.removeAttribute('open'));
    };

    dropdowns.forEach((dropdown) => {
      let hoverTimer = null;

      dropdown.addEventListener('toggle', () => {
        if (dropdown.open) {
          dropdowns.forEach((other) => {
            if (other !== dropdown) {
              other.removeAttribute('open');
            }
          });
        }
      });

      dropdown.addEventListener('mouseenter', () => {
        if (isDesktop()) {
          clearTimeout(hoverTimer);
          dropdown.setAttribute('open', '');
        }
      });

      dropdown.addEventListener('mouseleave', () => {
        if (isDesktop()) {
          hoverTimer = setTimeout(() => {
            dropdown.removeAttribute('open');
          }, 100);
        }
      });
    });

    document.addEventListener('click', (event) => {
      if (!event.target.closest('header')) {
        closeAllDropdowns();
        if (mobileMenu) mobileMenu.removeAttribute('open');
      }
    });

    if (mobileMenu) {
      mobileMenu.addEventListener('toggle', () => {
        if (!mobileMenu.open) closeAllDropdowns();
      });
      mobileMenu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => mobileMenu.removeAttribute('open'));
      });
    }
  </script>

  <style>
    header.header-scrolled {
      background-color: rgba(234, 242, 252, 0.85);
      border-color: rgba(169, 196, 232, 0.7);
      box-shadow: 0 6px 28px -6px rgba(2, 39, 90, 0.32);
    }
    @media (prefers-reduced-motion: reduce) {
      header {
        transition: none;
      }
      .nav-panel-item {
        transition: none;
      }
    }
  </style>
  <style>
    .nav-panel {
      border-radius: 18px;
      border: 1px solid rgba(169, 196, 232, 0.4);
      background: linear-gradient(155deg, rgba(3, 26, 66, 0.99) 0%, rgba(2, 39, 90, 0.99) 48%, rgba(0, 74, 221, 0.98) 100%);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      box-shadow: 0 20px 44px -14px rgba(2, 39, 90, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.08);
      transform-origin: top center;
      animation: nav-panel-in 0.18s cubic-bezier(0.22, 0.61, 0.36, 1) both;
    }
    @keyframes nav-panel-in {
      from {
        opacity: 0;
        transform: translateY(-6px) scale(0.98);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }
    .nav-panel--gift {
      background: linear-gradient(155deg, rgba(42, 17, 5, 0.99) 0%, rgba(2, 39, 90, 0.99) 40%, rgba(70, 46, 10, 0.99) 100%);
      border-color: rgba(216, 178, 106, 0.45);
      box-shadow: 0 20px 44px -14px rgba(40, 22, 4, 0.6), inset 0 1px 0 rgba(255, 233, 190, 0.14);
    }
    .nav-panel-item {
      border-radius: 12px;
      color: rgba(237, 244, 255, 0.92);
      transition: background-color 0.16s ease, color 0.16s ease;
    }
    .nav-panel-item:hover {
      background: linear-gradient(90deg, rgba(0, 74, 221, 0.5), rgba(46, 143, 130, 0.32));
      color: #ffffff;
    }
    .nav-panel--gift .nav-panel-item:hover {
      background: linear-gradient(90deg, rgba(193, 146, 47, 0.35), rgba(0, 74, 221, 0.35));
    }
    @media (prefers-reduced-motion: reduce) {
      .nav-panel {
        animation: none;
      }
    }
  </style>
</header>